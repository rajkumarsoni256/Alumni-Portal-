# Backend API Base URL
VITE_API_BASE_URL=http://localhost:8080

# Google OAuth 2.0 Web Client ID (Public identifier for Google Sign-In)
# Required in Google Cloud Console -> APIs & Services -> Credentials:
# - Authorized JavaScript origins: http://localhost:5173 (Development) & https://your-domain.vercel.app (Production)
VITE_GOOGLE_CLIENT_ID=
