PORT=8080
NODE_ENV=development
DB_HOST=localhost
DB_PORT=5432
DB_NAME=jecrc_community
DB_USER=postgres
DB_PASSWORD=your_db_password_here
DB_URL=postgres://postgres:your_db_password_here@localhost:5432/jecrc_community
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRATION=3600s
GOOGLE_CLIENT_ID=your_google_client_id_here
CLIENT_SECRET=your_google_client_secret_here
CLIENT_URL=http://localhost:5173
ADMIN_EMAIL=admin@jecrc.ac.in
ADMIN_PASSWORD=your_admin_password_here

# ======================================================
# EMAIL SYSTEM CONFIGURATION
# ======================================================
# Provider Options: console (default for local dev) | smtp | resend | sendgrid
EMAIL_PROVIDER=smtp
EMAIL_MODE=development

# Sender Details
EMAIL_FROM=no-reply@jecrc.ac.in
EMAIL_FROM_NAME=JU Connect Alumni Network
EMAIL_REPLY_TO=support@jecrc.ac.in

# Option A: SMTP Settings (e.g., Gmail App Password or custom SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_smtp_app_password_here

# Option B: API Key for Resend or SendGrid (Only required if EMAIL_PROVIDER is set to resend or sendgrid)
EMAIL_API_KEY=your_api_key_here

# App Base URLs for Links in Emails
APP_BASE_URL=http://localhost:8080
FRONTEND_BASE_URL=http://localhost:5173
